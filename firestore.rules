rules_version = '2';

// এই ফাইলটা আমার এই স্যান্ডবক্সে ডিপ্লয় করা যায়নি (নেটওয়ার্ক/ফায়ারবেস CLI নেই)।
// এটা ব্যবহার করতে: Firebase Console → আপনার প্রজেক্ট → Firestore Database →
// Rules ট্যাব → নিচের পুরো কনটেন্ট পেস্ট করে "Publish" চাপুন।
//
// এই নিয়ম অনুযায়ী:
// - products কালেকশন সবাই (ভিজিটর) পড়তে পারবে (পাবলিক সাইট কাজ করার জন্য দরকার)
// - কিন্তু লেখা/এডিট/ডিলিট শুধুমাত্র লগইন করা ইউজার (অর্থাৎ আপনার Admin Panel) করতে পারবে
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{sku} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // categories — হোমপেজের "Our Materials" গ্রিড ও /materials পেজগুলোর ডেটা।
    // সবাই পড়তে পারবে; লেখা/এডিট/ডিলিট শুধু লগইন করা Admin।
    match /categories/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // leads — /wholesale ও /contact পেজের ইনকোয়ারি ফর্মের সাবমিশন।
    // - ভিজিটর শুধু নতুন lead তৈরি (create) করতে পারবে, তা-ও কিছু বেসিক validation মেনে
    //   (আবশ্যক ফিল্ড, status অবশ্যই 'new', মাত্রাতিরিক্ত বড় ডেটা ঠেকাতে সাইজ লিমিট)
    // - পড়া/এডিট/মুছা শুধু লগইন করা Admin (/admin/leads পেজ)
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'source', 'status', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 200
                    && request.resource.data.source in ['wholesale', 'contact']
                    && request.resource.data.status == 'new'
                    && (!('message' in request.resource.data) || request.resource.data.message.size() < 5000);
      allow read, update, delete: if request.auth != null;
    }

    // অন্য কোনো কালেকশন (rfqs ইত্যাদি) থাকলে সেগুলোর জন্য নিয়ম আলাদাভাবে যোগ করতে হবে —
    // ডিফল্টে সবকিছু বন্ধ থাকে, যা পর্যন্ত না স্পষ্টভাবে allow করা হয়।
  }
}
