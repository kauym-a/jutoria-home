---
// lucide আইকন, প্লেইন inline SVG হিসেবে — vanilla `lucide` প্যাকেজের আইকন ডেটা বিল্ড-টাইমে
// পড়া হয় (মূল সাইটের lucide-react-এর একই ভার্সন 1.31.0, তাই আকৃতি হুবহু এক), কোনো JS
// রানটাইম ক্লায়েন্টে যায় না। name = lucide-এর kebab-case নাম, যেমন 'arrow-right', 'globe-2'।
import { icons } from 'lucide';

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className = '' } = Astro.props;
const pascal = name.replace(/(^|-)([a-z0-9])/g, (_, __, c: string) => c.toUpperCase());
const node = (icons as Record<string, [string, Record<string, string>][]>)[pascal];
if (!node) throw new Error(`Unknown lucide icon: "${name}"`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {node.map(([Tag, attrs]) => <Tag {...attrs} />)}
</svg>
