---
// lib/images.ts-এর optimizeImage() মোড়ানো একটা সাধারণ <img> — বিল্ড-টাইমে রেস্পন্সিভ
// WebP srcset বানায়। মূল সাইটের পেজগুলোতে অনেক ছবি CSS background-image হিসেবে ছিল
// (role="img" div) — সেগুলো ব্রাউজারের preload scanner আগে দেখতে পায় না, lazy-load বা
// fetchpriority দেওয়া যায় না; সেগুলোও এই কম্পোনেন্ট দিয়ে সাধারণ <img object-cover>-এ বদলানো
// হচ্ছে (backgroundPosition → objectPosition)। হিরো/LCP ছবিতে loading="eager" +
// fetchpriority="high" দিলে আলাদা <link rel="preload"> লাগে না — HTML-এই <img> আছে।
import { optimizeImage } from '../lib/images';

interface Props {
  src: string;
  widths: number[];
  sizes: string;
  alt: string;
  class?: string;
  style?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number | string;
  height?: number | string;
  /** WebP কোয়ালিটি — ডিফল্ট ৮০; গ্রেডিয়েন্ট ওভারলের নিচের হিরোতে ৬৫ (lib/images.ts দেখুন)। */
  quality?: number;
}

const { src, widths, sizes, loading = 'lazy', quality, ...rest } = Astro.props;
const img = await optimizeImage(src, widths, quality);
---

<img src={img?.src ?? src} srcset={img?.srcset} sizes={img?.srcset ? sizes : undefined} loading={loading} decoding="async" {...rest} />
