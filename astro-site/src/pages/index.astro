<script>
  // ১. হিরো ভিডিও ও সার্টিফিকেশন লোগো — দুটোই window 'load'-এর পরে, যাতে হিরো poster
  //    (LCP) লোড হওয়ার সময় এরা ব্যান্ডউইথ না নেয় (মূল Home.tsx-এর কমেন্ট দেখুন)।
  const afterLoad = () => {
    document.querySelector<HTMLVideoElement>('[data-hero-video]')?.play().catch(() => {});
    document.querySelectorAll<HTMLImageElement>('img[data-deferred-src]').forEach((img) => {
      img.src = img.dataset.deferredSrc!;
    });
  };
  if (document.readyState === 'complete') afterLoad();
  else window.addEventListener('load', afterLoad, { once: true });

  // ২. স্ক্রল-রিভিল — প্রতিটা সেকশন একবার viewport-এ এলে তার ভেতরের সব data-reveal-from
  //    এলিমেন্টের ক্লাস শেষ অবস্থায় বদলে যায় (মূল ফাইলের isArtisanVisible ইত্যাদি)।
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-reveal-section]').forEach((section) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        section.querySelectorAll<HTMLElement>('[data-reveal-from]').forEach((el) => {
          const isZoom = el.dataset.revealFrom!.startsWith('scale');
          if (isZoom && reducedMotion) return;
          el.classList.remove(...el.dataset.revealFrom!.split(' '));
          el.classList.add(...el.dataset.revealTo!.split(' '));
        });
        io.disconnect();
      },
      { threshold: 0, rootMargin: '0px 0px -10% 0px' },
    );
    io.observe(section);
  });

  // ৩. Artisan ছবির সূক্ষ্ম প্যারালাক্স (reduced-motion-এ বন্ধ), rAF দিয়ে থ্রটল করা।
  const parallax = document.querySelector<HTMLElement>('[data-parallax]');
  if (parallax && !reducedMotion) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const rect = parallax.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.top <= vh && rect.bottom >= 0) {
        const distance = vh / 2 - (rect.top + rect.height / 2);
        parallax.style.transform = `translateY(${distance * -0.04}px)`;
      }
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>
