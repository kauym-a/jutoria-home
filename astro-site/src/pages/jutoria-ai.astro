---
// মূল src/pages/public/JutoriaAI.tsx থেকে পোর্ট করা — standalone চ্যাট প্যানেল।
import PublicLayout from '../layouts/PublicLayout.astro';
import ChatPanel from '../components/ChatPanel.astro';
---

<PublicLayout
  title="JUTORIA AI Assistant"
  description="Ask the JUTORIA AI Assistant about product pricing, MOQ, materials and the wholesale process."
>
  <section class="border-b border-brand-navy/10 bg-[#f7f4ee]">
    <div class="container mx-auto max-w-4xl px-4 py-16 md:py-20 text-center">
      <span class="mb-5 block font-sans text-[11px] font-bold tracking-[0.24em] text-[#8a6a29] uppercase">Jutoria AI</span>
      <h1 class="text-4xl md:text-5xl font-serif font-bold leading-[0.95] tracking-[-0.03em] text-brand-navy mb-6">Ask the JUTORIA Assistant</h1>
      <p class="max-w-xl mx-auto font-sans text-base md:text-lg text-brand-navy/75 font-light leading-relaxed">
        Pricing, MOQ, materials, wholesale process, or how to reach our team — ask directly below.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-20 bg-brand-offwhite">
    <div class="container mx-auto px-4">
      <ChatPanel standalone />
    </div>
  </section>
</PublicLayout>
