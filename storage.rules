rules_version = '2';

// এই ফাইলটা এই স্যান্ডবক্সে ডিপ্লয় করা যায়নি (নেটওয়ার্ক/ফায়ারবেস CLI নেই)।
// এটা ব্যবহার করতে: Firebase Console → আপনার প্রজেক্ট → Storage → Rules ট্যাব →
// নিচের পুরো কনটেন্ট পেস্ট করে "Publish" চাপুন।
//
// এই নিয়ম অনুযায়ী:
// - product-images/ ফোল্ডারের ছবি সবাই (ভিজিটর) দেখতে পারবে (পাবলিক সাইটে দেখানোর জন্য দরকার)
// - কিন্তু আপলোড/ডিলিট শুধুমাত্র লগইন করা ইউজার (অর্থাৎ আপনার Admin Panel) করতে পারবে
// - প্রতিটা ফাইল সর্বোচ্চ ১৫ MB এবং শুধু image/* টাইপ হতে হবে (ভুল ফাইল টাইপ/অতিরিক্ত বড় ফাইল ঠেকাতে)
service firebase.storage {
  match /b/{bucket}/o {

    match /product-images/{sku}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // category-images/ — Admin Categories পেজ থেকে আপলোড করা ক্যাটাগরি ছবি।
    match /category-images/{slug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ডিফল্টে সবকিছু বন্ধ থাকে, যতক্ষণ না স্পষ্টভাবে allow করা হয়।
  }
}
